APP_NAME=ThreeDOS
APP_ENV=local
APP_KEY=
APP_DEBUG=false
TELESCOPE_ENABLED=false
APP_URL=http://localhost

# CORS allowed origins (comma-separated)
# For production: specify exact frontend URLs (e.g., https://yourdomain.com)
# For development: can use wildcard for local development
CORS_ALLOWED_ORIGINS=*

# CORS supports credentials (cookies, authorization headers)
# Only set to true if your frontend uses cookies or authentication headers
CORS_SUPPORTS_CREDENTIALS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------
# Database
# Option A (default): SQLite — no server needed.
#   - The file is auto-created by `composer run setup`.
# ------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_DATABASE=absolute/path/to/database.sqlite  (defaults to database/database.sqlite)

# ------------------------------------------------------------
# Option B: MySQL (comment out the sqlite lines above and uncomment below)
# ------------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=threedos
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------
# Queue Driver
# Option A (default): database — no server needed.
# Option B: redis — recommended for production (locks, rate limiting)
# ------------------------------------------------------------
QUEUE_CONNECTION=database

# ------------------------------------------------------------
# Queue Worker
# For production with QUEUE_CONNECTION=database:
# - Run: php artisan queue:work --sleep=3 --tries=3
# - Use supervisor to keep worker running continuously
# - For QUEUE_CONNECTION=redis:
# - Run: php artisan queue:work --queue=default --sleep=3 --tries=3
# ------------------------------------------------------------
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TRIES=3

# ------------------------------------------------------------
# Cache Driver
# Option A (default): database — no server needed.
# Option B: redis — recommended for production (locks, performance)
# ------------------------------------------------------------
CACHE_STORE=database

# ------------------------------------------------------------
# Cache Configuration
# For production with CACHE_STORE=database:
# - Use tag-based caching for better performance
# - Monitor cache hit rate
# For CACHE_STORE=redis:
# - Redis provides automatic expiration and distributed caching
# - Recommended for high-traffic applications
# ------------------------------------------------------------
CACHE_PREFIX=threedos_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Generate a real value with: php artisan jwt:secret
JWT_SECRET=

# ------------------------------------------------------------
# Paymob (payment gateway)
# ------------------------------------------------------------
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC=
PAYMOB_INTEGRATION_IDS=

# ------------------------------------------------------------
# AI providers
# - GROQ_API_KEY : AI itinerary generation (GroqService)
# - OPENAI_API_KEY : AI map attraction suggestions (MapController)
# ------------------------------------------------------------
GROQ_API_KEY=
OPENAI_API_KEY=
# Phase 9: env-driven site settings (SettingsSeeder)
SITE_FORK_PRICE_CENTS=50000
PLATFORM_COMMISSION_RATE=0.05
