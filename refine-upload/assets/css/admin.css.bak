@import "auth.css";

/* ---------- shell layout ---------- */
html, body { height: 100%; }
body[data-page="admin"] { padding: 0; }

.shell {
  display: flex;
  min-height: 100vh;
}

/* ---------- sidebar ---------- */
.sidebar {
  width: 240px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  border-right: 1px solid hsl(var(--border));
  background: hsl(var(--card));
}
.sidebar-brand {
  padding: 1.1rem 1.25rem;
  border-bottom: 1px solid hsl(var(--border));
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}
.sidebar-brand .brand { font-weight: 800; letter-spacing: -0.02em; color: hsl(var(--primary)); }
.brand-sub { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: hsl(var(--muted-foreground)); }

.nav { padding: 0.75rem; display: flex; flex-direction: column; gap: 0.2rem; flex: 1; }
.nav-section {
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: hsl(var(--muted-foreground));
  padding: 0.9rem 0.6rem 0.3rem;
}
.nav-item {
  display: block;
  padding: 0.5rem 0.65rem;
  border-radius: calc(var(--radius) * 0.8);
  color: hsl(var(--muted-foreground));
  text-decoration: none;
  font-size: 0.88rem;
  font-weight: 500;
  transition: background 0.15s ease, color 0.15s ease;
}
.nav-item:hover { background: hsl(var(--accent)); color: hsl(var(--foreground)); }
.nav-item.is-active { background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); }

.sidebar-foot { padding: 0.9rem 1.25rem; border-top: 1px solid hsl(var(--border)); }
.btn-block { width: 100%; }

.btn-ghost {
  padding: 0.4rem 0.8rem;
  font-size: 0.85rem;
  font-weight: 600;
  font-family: inherit;
  color: hsl(var(--muted-foreground));
  background: transparent;
  border: 1px solid hsl(var(--border));
  border-radius: var(--radius);
  cursor: pointer;
  transition: color 0.15s ease, border-color 0.15s ease;
}
.btn-ghost:hover { color: hsl(var(--foreground)); border-color: hsl(var(--input)); }

/* ---------- content ---------- */
.content { flex: 1; min-width: 0; padding: 0 1.5rem 3rem; }
.content-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.6rem 0 1.1rem;
  margin-bottom: 0.5rem;
  border-bottom: 1px solid hsl(var(--border));
}
.content-head h1 { margin: 0 0 0.15rem; font-size: 1.45rem; letter-spacing: -0.02em; }
.view-sub { margin: 0; color: hsl(var(--muted-foreground)); font-size: 0.9rem; }
.right-title p { margin: 0; }

.view[hidden] { display: none; }

/* ---------- chips ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  background: hsl(var(--accent));
  font-size: 0.82rem;
  font-weight: 600;
}
.chip[hidden] { display: none; }
.chip-role {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 0.1rem 0.45rem;
  border-radius: 999px;
  background: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
}

/* ---------- kpis ---------- */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}
.kpi {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 1rem 1.1rem;
  background: hsl(var(--card));
  border: 1px solid hsl(var(--border));
  border-radius: var(--radius);
}
.kpi-label { font-size: 0.75rem; color: hsl(var(--muted-foreground)); }
.kpi-value { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }

/* ---------- panels ---------- */
.panel {
  background: hsl(var(--card));
  border: 1px solid hsl(var(--border));
  border-radius: var(--radius);
  padding: 1.25rem;
}
.panel h2 { margin: 0 0 0.35rem; font-size: 1.05rem; letter-spacing: -0.01em; }
.muted { color: hsl(var(--muted-foreground)); font-size: 0.88rem; }

.module-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
  gap: 0.75rem;
  margin-top: 1rem;
}
.module {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  padding: 0.9rem 1rem;
  border: 1px solid hsl(var(--border));
  border-radius: var(--radius);
  background: hsl(var(--background));
  text-decoration: none;
  color: inherit;
  transition: border-color 0.15s ease, transform 0.15s ease;
}
.module:hover { border-color: hsl(var(--primary)); transform: translateY(-1px); }
.module strong { font-size: 0.92rem; }
.module span { font-size: 0.78rem; color: hsl(var(--muted-foreground)); }

/* ---------- access denied ---------- */
.access-denied { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; }
.access-denied[hidden] { display: none; }
.denied-card {
  max-width: 380px;
  text-align: center;
  padding: 2.5rem 2rem;
  background: hsl(var(--card));
  border: 1px solid hsl(var(--border));
  border-radius: calc(var(--radius) * 1.5);
}
.denied-icon { font-size: 2.2rem; display: block; margin-bottom: 0.75rem; }
.denied-card h1 { margin: 0 0 0.4rem; font-size: 1.35rem; }
.denied-card p { margin: 0 0 1.25rem; color: hsl(var(--muted-foreground)); font-size: 0.92rem; }

/* ---------- skel loading ---------- */
.shell-loading { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.8rem; }
.shell-loading[hidden] { display: none; }
.shell-loading p { margin: 0; color: hsl(var(--muted-foreground)); font-size: 0.9rem; }
.spinner {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 3px solid hsl(var(--border));
  border-top-color: hsl(var(--primary));
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- placeholder ---------- */
.placeholder { text-align: center; padding: 3rem 1.5rem; }
.placeholder-icon { font-size: 2rem; display: block; margin-bottom: 0.5rem; }

/* ---------- skeleton (inherited) ---------- */
.kpi.skeleton { min-height: 3.8rem; }
.skeleton {
  min-height: 2.4rem;
  border-radius: var(--radius);
  background: linear-gradient(100deg, hsl(var(--muted)) 40%, hsl(var(--accent)) 50%, hsl(var(--muted)) 60%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease infinite;
}
@keyframes shimmer { to { background-position: -200% 0; } }

/* ---------- footer banner (shared) ---------- */
#site-banner {
  position: fixed;
  left: 50%;
  bottom: 1.25rem;
  transform: translate(-50%, 140%);
  display: flex;
  align-items: center;
  gap: 0.6rem;
  max-width: min(560px, calc(100% - 2rem));
  padding: 0.75rem 1rem;
  font-size: 0.88rem;
  border-radius: calc(var(--radius) * 1.5);
  background: hsl(var(--card));
  color: hsl(var(--foreground));
  box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.3);
  border: 1px solid hsl(var(--border));
  opacity: 0;
  pointer-events: none;
  transition: transform 0.3s ease, opacity 0.3s ease;
  z-index: 50;
}
#site-banner.is-show { transform: translate(-50%, 0); opacity: 1; }
#site-banner.is-error { border-color: hsl(var(--destructive)); }
#site-banner.is-error::before { content: "⚠"; color: hsl(var(--destructive)); font-weight: 700; }
#site-banner.is-info { border-color: hsl(var(--ring)); }
#site-banner.is-ok { border-color: hsl(150 50% 40%); }
#site-banner.is-ok::before { content: "✓"; color: hsl(150 50% 40%); font-weight: 700; }
#site-banner-drain {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 3px;
  width: 100%;
  background: hsl(150 50% 40% / 0.7);
  border-radius: 0 0 calc(var(--radius) * 1.5) calc(var(--radius) * 1.5);
  transform-origin: left center;
}
#site-banner.is-error #site-banner-drain { background: hsl(var(--destructive) / 0.7); }

/* ---------- responsive ---------- */
@media (max-width: 720px) {
  .shell { flex-direction: column; }
  .sidebar { width: 100%; }
  .nav { flex-direction: row; flex-wrap: wrap; }
  .nav-section { display: none; }
  .content-head { flex-direction: column; align-items: flex-start; }
}

/* ---------- kit: grids, tables, forms, modal ---------- */
.kit-grid { display: flex; flex-direction: column; gap: 0.75rem; }
.kit-toolbar { display: flex; gap: 0.5rem; }
.kit-grid-skeleton { display: flex; flex-direction: column; gap: 0.5rem; }
.kit-grid-skeleton .box { min-height: 3rem; }
.kit-error {
  padding: 1.25rem;
  border: 1px solid hsl(var(--destructive));
  border-radius: var(--radius);
  color: hsl(var(--destructive));
  background: hsl(var(--card));
  font-size: 0.9rem;
}
.kit-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
.kit-table th {
  text-align: left;
  padding: 0.6rem 0.75rem;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: hsl(var(--muted-foreground));
  border-bottom: 1px solid hsl(var(--border));
}
.kit-table td {
  padding: 0.65rem 0.75rem;
  border-bottom: 1px solid hsl(var(--border));
  vertical-align: middle;
}
.kit-table tr:hover td { background: hsl(var(--accent) / 0.5); }
.kit-table .th-actions, .kit-table .td-actions { text-align: right; white-space: nowrap; }
.kit-table .kit-empty { text-align: center; color: hsl(var(--muted-foreground)); padding: 1.5rem; }
.td-actions { display: flex; gap: 0.4rem; justify-content: flex-end; }

.btn-sm { padding: 0.25rem 0.55rem; font-size: 0.78rem; }
.badge {
  display: inline-block;
  padding: 0.15rem 0.5rem;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.badge-ok { background: hsl(150 55% 38% / 0.15); color: hsl(150 45% 32%); }
.badge-off { background: hsl(var(--muted)); color: hsl(var(--muted-foreground)); }
.is-danger-text { color: hsl(var(--destructive)); }
.is-danger-text:hover { border-color: hsl(var(--destructive)); color: hsl(var(--destructive)); }
.btn-primary.is-danger { background: hsl(var(--destructive)); border-color: hsl(var(--destructive)); color: #fff; }
.btn-primary.is-danger:hover { background: hsl(var(--destructive) / 0.85); }

/* modal */
.kit-modal-backdrop {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 5vh 1rem 2rem;
  background: rgb(0 0 0 / 0.45);
  z-index: 100;
  overflow-y: auto;
}
.kit-modal {
  width: min(480px, 100%);
  background: hsl(var(--card));
  border: 1px solid hsl(var(--border));
  border-radius: calc(var(--radius) * 1.5);
  box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.4);
}
.kit-modal-head { padding: 1rem 1.25rem 0.6rem; border-bottom: 1px solid hsl(var(--border)); }
.kit-modal-head h3 { margin: 0; font-size: 1.05rem; }
.kit-modal-body { padding: 1.25rem; }
.kit-modal-foot { padding: 0.9rem 1.25rem; border-top: 1px solid hsl(var(--border)); display: flex; justify-content: flex-end; gap: 0.5rem; }
.confirm-text { margin: 0 0 1rem; font-size: 0.92rem; }

/* form fields (auth-field anatomy, kit namespace) */
.kit-form { display: flex; flex-direction: column; gap: 0.75rem; }
.kit-field { display: flex; flex-direction: column; gap: 0.3rem; }
.kit-field label { font-size: 0.82rem; font-weight: 600; }
.kit-field label.is-required::after { content: " *"; color: hsl(var(--destructive)); }
.kit-field .field-hint { font-size: 0.75rem; color: hsl(var(--muted-foreground)); }
.kit-field input,
.kit-field select,
.kit-field textarea {
  width: 100%;
  padding: 0.5rem 0.7rem;
  font-family: inherit;
  font-size: 0.9rem;
  color: hsl(var(--foreground));
  background: hsl(var(--background));
  border: 1px solid hsl(var(--input));
  border-radius: var(--radius);
}
.kit-field input:focus-visible,
.kit-field select:focus-visible,
.kit-field textarea:focus-visible {
  outline: none;
  border-color: hsl(var(--ring));
  box-shadow: 0 0 0 3px hsl(var(--ring) / 0.2);
}
.kit-field.has-error input,
.kit-field.has-error select,
.kit-field.has-error textarea,
.kit-field input.is-error {
  border-color: hsl(var(--destructive));
}
.kit-field input.is-valid { border-color: hsl(150 55% 38%); }
.field-error { font-size: 0.76rem; color: hsl(var(--destructive)); }

/* ---------- reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: 0.001s !important;
    animation-duration: 0.001s !important;
    animation-iteration-count: 1 !important;
  }
}