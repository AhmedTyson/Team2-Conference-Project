# Root gitignore for Fullstack Monorepo

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Node & Package Manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Temp Files
.env
.env.local
.env.*.local
*.log
tmp/
scratch/

# Laravel generated/local files
/vendor/
/storage/*
/bootstrap/cache/
/.phpunit.result.cache

# Local database
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-wal
/database/*.sqlite-shm