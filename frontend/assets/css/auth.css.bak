/* ============================================================
   auth.css — Itinari auth pages
   shadcn-inspired token layer + split-screen layout
   ============================================================ */

/* ---------- shadcn-style design tokens ---------- */
:root {
  --background: 0 0% 100%;
  --foreground: 240 10% 3.9%;
  --card: 0 0% 100%;
  --card-foreground: 240 10% 3.9%;
  --primary: 12 92% 55%;          /* Itinari coral */
  --primary-foreground: 0 0% 100%;
  --secondary: 240 4.8% 95.9%;
  --secondary-foreground: 240 5.9% 10%;
  --muted: 240 4.8% 95.9%;
  --muted-foreground: 240 3.8% 46.1%;
  --accent: 240 4.8% 95.9%;
  --accent-foreground: 240 5.9% 10%;
  --destructive: 0 84.2% 60.2%;
  --destructive-foreground: 0 0% 98%;
  --border: 240 5.9% 90%;
  --input: 240 5.9% 90%;
  --ring: 12 92% 55%;
  --radius: 0.625rem;
}

.dark {
  --background: 240 10% 3.9%;
  --foreground: 0 0% 98%;
  --card: 240 10% 3.9%;
  --card-foreground: 0 0% 98%;
  --primary: 12 92% 60%;
  --primary-foreground: 0 0% 100%;
  --secondary: 240 3.7% 15.9%;
  --secondary-foreground: 0 0% 98%;
  --muted: 240 3.7% 15.9%;
  --muted-foreground: 240 5% 64.9%;
  --accent: 240 3.7% 15.9%;
  --accent-foreground: 0 0% 98%;
  --border: 240 3.7% 15.9%;
  --input: 240 3.7% 15.9%;
  --ring: 12 92% 60%;
}

/* ---------- base ---------- */
* { box-sizing: border-box; }

html, body { height: 100%; }

body {
  margin: 0;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: hsl(var(--background));
  color: hsl(var(--foreground));
  -webkit-font-smoothing: antialiased;
  display: grid;
  place-items: center;
  padding: 1.5rem;
}

/* ---------- split-screen layout ---------- */
.auth-shell {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  width: min(1080px, 100%);
  min-height: min(680px, 92vh);
  border-radius: calc(var(--radius) * 2);
  overflow: hidden;
  box-shadow: 0 24px 70px -24px rgba(0, 0, 0, 0.25);
}

.auth-visual {
  position: relative;
  background:
    radial-gradient(120% 120% at 0% 0%, hsl(12 92% 60% / 0.85), hsl(12 92% 45%) 55%, hsl(12 92% 32%));
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 2.5rem;
}

.auth-visual::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.08) 25%, transparent 25%) 0 0 / 48px 48px,
    linear-gradient(315deg, rgba(255,255,255,0.08) 25%, transparent 25%) 0 0 / 48px 48px;
  opacity: 0.35;
  pointer-events: none;
}

.auth-visual h1 { font-size: 1.75rem; line-height: 1.2; margin: 0 0 0.5rem; position: relative; z-index: 1; }
.auth-visual p { margin: 0; opacity: 0.92; max-width: 34ch; position: relative; z-index: 1; }
.auth-visual .brand { position: relative; z-index: 1; font-weight: 800; letter-spacing: -0.02em; font-size: 1.25rem; }

.auth-form-side {
  background: hsl(var(--card));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2.5rem;
}

/* ---------- card ---------- */
.auth-card {
  width: min(400px, 100%);
}

.auth-card h2 { margin: 0 0 0.25rem; font-size: 1.5rem; letter-spacing: -0.02em; }
.auth-card .sub { margin: 0 0 1.75rem; color: hsl(var(--muted-foreground)); font-size: 0.9rem; }

/* ---------- fields ---------- */
.field { margin-bottom: 1rem; }

.field label {
  display: block;
  font-size: 0.8rem;
  font-weight: 600;
  margin-bottom: 0.4rem;
}

.field input {
  width: 100%;
  padding: 0.6rem 0.8rem;
  font-size: 0.95rem;
  font-family: inherit;
  color: hsl(var(--foreground));
  background: hsl(var(--background));
  border: 1px solid hsl(var(--input));
  border-radius: var(--radius);
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.field input::placeholder { color: hsl(var(--muted-foreground) / 0.7); }

/* password show/hide wrapper (phase 5) */
.input-wrap {
  position: relative;
}
.input-wrap input[type="password"],
.input-wrap input[type="text"] {
  padding-right: 2.75rem;
}
.pw-toggle {
  position: absolute;
  top: 50%;
  right: 0.4rem;
  transform: translateY(-50%);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  padding: 0;
  border: none;
  border-radius: var(--radius);
  background: transparent;
  color: hsl(var(--muted-foreground));
  cursor: pointer;
  font-size: 1.05rem;
  line-height: 1;
  transition: color 0.15s ease, background 0.15s ease;
}
.pw-toggle:hover { color: hsl(var(--foreground)); background: hsl(var(--muted) / 0.4); }
.pw-toggle:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px hsl(var(--ring) / 0.4);
}

.field input:focus-visible {
  border-color: hsl(var(--ring));
  box-shadow: 0 0 0 3px hsl(var(--ring) / 0.25);
}

/* error states */
.field.has-error input:not([type="checkbox"]),
.field input.is-error:not([type="checkbox"]) {
  border-color: hsl(var(--destructive));
}

.field input.is-invalid-ring {
  border-color: hsl(var(--destructive));
  box-shadow: 0 0 0 3px hsl(var(--destructive) / 0.2);
}

/* valid states (phase 4) */
.field input.is-valid:not([type="checkbox"]) {
  border-color: hsl(150 55% 46%);
  box-shadow: 0 0 0 3px hsl(150 55% 46% / 0.18);
}

.field-hint {
  display: none;
  margin-top: 0.35rem;
  font-size: 0.78rem;
  color: hsl(var(--destructive));
}

.field-hint.show { display: block; }

.field-hint.hint-valid { color: hsl(150 55% 38%); }

/* password strength meter (phase 4) */
.strength-meter {
  display: flex;
  gap: 0.3rem;
  margin-top: 0.4rem;
}
.strength-meter .bar {
  flex: 1;
  height: 4px;
  border-radius: 999px;
  background: hsl(var(--muted));
  transition: background 0.2s ease;
}
.strength-meter.weak .bar:nth-child(1) { background: hsl(var(--destructive)); }
.strength-meter.fair .bar:nth-child(-n+3) { background: hsl(38 92% 56%); }
.strength-meter.strong .bar:nth-child(-n+5) { background: hsl(150 55% 46%); }

.strength-note {
  margin-top: 0.3rem;
  font-size: 0.75rem;
  color: hsl(var(--muted-foreground));
}
.strength-note.weak { color: hsl(var(--destructive)); }
.strength-note.fair { color: hsl(38 92% 42%); }
.strength-note.strong { color: hsl(150 55% 38%); }

.hint-list {
  margin-top: 0.35rem;
  font-size: 0.75rem;
  color: hsl(var(--muted-foreground));
}
.hint-list li { margin: 0.1rem 0; }
.hint-list li.met { color: hsl(150 55% 38%); }
.hint-list li.met::before { content: "✓ "; }

/* terms checkbox (phase 5) */
.terms-field {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin: 0.25rem 0 1rem;
}
.terms-field input[type="checkbox"] {
  width: 1rem;
  height: 1rem;
  margin-top: 0.1rem;
  accent-color: hsl(var(--primary));
}
.terms-field label {
  font-size: 0.82rem;
  font-weight: 400;
  color: hsl(var(--muted-foreground));
  margin: 0;
}
.terms-field label a { color: hsl(var(--primary)); font-weight: 600; }
.terms-field.has-error label { color: hsl(var(--destructive)); }
.terms-field.has-error input[type="checkbox"] {
  outline: 2px solid hsl(var(--destructive) / 0.5);
  outline-offset: 2px;
}

/* email availability hint (phase 5) */
.hint-availability {
  color: hsl(var(--muted-foreground));
}
.hint-availability.checking { color: hsl(var(--muted-foreground)); }
.hint-availability.available { color: hsl(150 55% 38%); }
.hint-availability.taken { color: hsl(var(--destructive)); }
.hint-availability::before { content: "… "; }
.hint-availability.available::before { content: "✓ "; }
.hint-availability.taken::before { content: "✗ "; }

/* ---------- actions ---------- */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.65rem 1rem;
  font-size: 0.95rem;
  font-weight: 600;
  font-family: inherit;
  color: hsl(var(--primary-foreground));
  background: hsl(var(--primary));
  border: none;
  border-radius: var(--radius);
  cursor: pointer;
  transition: background 0.15s ease, transform 0.1s ease;
}

.btn-primary:hover:not(:disabled) { background: hsl(var(--primary) / 0.88); }
.btn-primary:active:not(:disabled) { transform: scale(0.98); }
.btn-primary:disabled { opacity: 0.65; cursor: not-allowed; }

/* loading spinner (spec #2) */
.btn-primary.is-loading .btn-label { opacity: 0.75; }
.spinner {
  display: none;
  width: 1rem;
  height: 1rem;
  border: 2px solid hsl(var(--primary-foreground) / 0.35);
  border-top-color: hsl(var(--primary-foreground));
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
.btn-primary.is-loading .spinner { display: inline-block; }

@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- success note ---------- */
.success-note {
  display: none;
  margin-top: 1rem;
  padding: 0.7rem 0.9rem;
  font-size: 0.85rem;
  color: hsl(150 60% 28%);
  background: hsl(150 60% 92%);
  border-radius: var(--radius);
}
.success-note.is-show { display: block; }

/* ---------- links ---------- */
.auth-links {
  margin-top: 1.25rem;
  font-size: 0.85rem;
  text-align: center;
  color: hsl(var(--muted-foreground));
}
.auth-links a { color: hsl(var(--primary)); font-weight: 600; text-decoration: none; }
.auth-links a:hover { text-decoration: underline; }
.auth-links .sep { margin: 0 0.4rem; opacity: 0.5; }

/* ---------- site banner ---------- */
#site-banner {
  position: fixed;
  left: 50%;
  bottom: 1.25rem;
  transform: translate(-50%, 140%);
  display: flex;
  align-items: center;
  gap: 0.6rem;
  max-width: min(560px, calc(100% - 2rem));
  padding: 0.75rem 1rem;
  font-size: 0.88rem;
  border-radius: calc(var(--radius) * 1.5);
  background: hsl(var(--card));
  color: hsl(var(--foreground));
  box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.3);
  border: 1px solid hsl(var(--border));
  opacity: 0;
  pointer-events: none;
  transition: transform 0.3s ease, opacity 0.3s ease;
  z-index: 50;
}
#site-banner.is-show { transform: translate(-50%, 0); opacity: 1; }
#site-banner.is-error { border-color: hsl(var(--destructive)); }
#site-banner.is-error::before {
  content: "⚠";
  color: hsl(var(--destructive));
  font-weight: 700;
}
#site-banner.is-info { border-color: hsl(var(--ring)); }
#site-banner.is-ok { border-color: hsl(150 50% 40%); }
#site-banner.is-ok::before {
  content: "✓";
  color: hsl(150 50% 40%);
  font-weight: 700;
}

/* banner progress drain (phase 6) */
#site-banner-drain {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 3px;
  width: 100%;
  background: hsl(150 50% 40% / 0.7);
  border-radius: 0 0 calc(var(--radius) * 1.5) calc(var(--radius) * 1.5);
  transform-origin: left center;
}
#site-banner.is-error #site-banner-drain { background: hsl(var(--destructive) / 0.7); }

/* ---------- responsive ---------- */
@media (max-width: 820px) {
  .auth-shell { grid-template-columns: 1fr; }
  .auth-visual { display: none; }
  body { padding: 0; }
  .auth-form-side { min-height: 100vh; }
}

/* ---------- reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: 0.001s !important;
    animation-duration: 0.001s !important;
    animation-iteration-count: 1 !important;
  }
  .field input.is-valid:not([type="checkbox"]),
  .field input.is-invalid-ring {
    box-shadow: none;
  }
}
