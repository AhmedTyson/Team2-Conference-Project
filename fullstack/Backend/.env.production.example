# ------------------------------------------------------------
# Production Environment Configuration
# Copy this file to .env and update values
# ------------------------------------------------------------

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=Itinari
APP_ENV=production
APP_KEY=
APP_DEBUG=false
TELESCOPE_ENABLED=false
APP_URL=https://yourdomain.com

# ------------------------------------------------------------
# Telescope (Development debugging tool) - PRODUCTION
# ------------------------------------------------------------
# WARNING: Telescope exposes sensitive application data.
# Only enable when absolutely necessary for debugging.
#
# Access URL: https://yourdomain.com/telescope
#
# Restrict which watchers collect data to minimize data exposure:
TELESCOPE_QUERY_WATCHER=false
TELESCOPE_EXCEPTION_WATCHER=false
TELESCOPE_LOG_WATCHER=false
TELESCOPE_REQUEST_WATCHER=false
TELESCOPE_CACHE_WATCHER=false
TELESCOPE_MODEL_WATCHER=false
TELESCOPE_JOB_WATCHER=false
TELESCOPE_MAIL_WATCHER=false
TELESCOPE_NOTIFICATION_WATCHER=false
TELESCOPE_GATE_WATCHER=false
TELESCOPE_EVENT_WATCHER=false
TELESCOPE_DUMP_WATCHER=false
TELESCOPE_CLIENT_REQUEST_WATCHER=false
TELESCOPE_COMMAND_WATCHER=false
TELESCOPE_REDIS_WATCHER=false
TELESCOPE_SCHEDULE_WATCHER=false
TELESCOPE_VIEW_WATCHER=false

# Optional: Restrict Telescope to specific domain
# TELESCOPE_DOMAIN=telescope.yourdomain.com

# ------------------------------------------------------------
# Database (MySQL recommended for production)
# ------------------------------------------------------------
DB_CONNECTION=mysql
# For Railway: set these from your Railway MySQL service variables
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

# ------------------------------------------------------------
# Redis (Recommended for production)
# ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# ------------------------------------------------------------
# Cache (Redis recommended)
# ------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=threedos_production_

# ------------------------------------------------------------
# Session (Database recommended for production)
# ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------
# Queue (Redis recommended)
# ------------------------------------------------------------
QUEUE_CONNECTION=redis
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TRIES=3

# ------------------------------------------------------------
# Mail (Production SMTP)
# ------------------------------------------------------------
# For production, use SMTP (recommended):
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
STORAGE_DISK=local
STORAGE_PATH=/var/www/threedos/storage/app

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_here
JWT_TTL=120
JWT_ALGO=HS256

# ------------------------------------------------------------
# Groq AI API
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gemma-7b-it

# ------------------------------------------------------------
# Paymob Payment Gateway
# ------------------------------------------------------------
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_MERCHANT_ID=your_merchant_id
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_NOTIFICATION_URL=https://yourdomain.com/api/webhooks/paymob

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Comma-separated list of allowed origins (your Railway app URL)
# Since Frontend is served from Laravel public/, same-origin requests
# are always allowed. Add any additional external origins below.
CORS_ALLOWED_ORIGINS=https://yourapp.up.railway.app

# ------------------------------------------------------------
# Seeding (First Deploy Only)
# ------------------------------------------------------------
# Set to true for first deploy to seed admin/agency/customer accounts.
# UNSET or set to false after first successful deploy.
SEED_ON_DEPLOY=false
CORS_SUPPORTS_CREDENTIALS=true

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Enable HTTPS only
APP_URL=https://yourdomain.com

# Set secure cookie flags
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

# Enable CSRF protection (default)
# CSRF_PROTECTION=true
